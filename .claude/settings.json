{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(uv run pytest *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(/api/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-bash.py",
            "args": []
          }
        ]
      }
    ]
  }
}
